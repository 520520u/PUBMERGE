    "compare_marks_summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlights are merged automatically. This list shows notes, bookmarks, tags, and conflicts so the app stays responsive with large backups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los subrayados se fusionan automáticamente. Esta lista muestra notas, marcadores, etiquetas y conflictos para que la app siga respondiendo con copias grandes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标注会自动合并。此列表只显示笔记、书签、标签和冲突，以便在大型备份下保持流畅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標註會自動合併。此列表只顯示筆記、書籤、標籤和衝突，以便在大型備份下保持流暢。"
          }
        }
      }
    },

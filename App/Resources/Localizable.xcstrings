    "about_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PubMerge imports, compares, and merges real .jwlibrary backups, then exports a validated file ready to restore."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PubMerge importa, compara y fusiona copias .jwlibrary reales, y exporta un archivo validado listo para restaurar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PubMerge 导入、比较并合并真实的 .jwlibrary 备份，然后导出可还原的已验证文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PubMerge 匯入、比較並合併真實的 .jwlibrary 備份，然後匯出可還原的已驗證檔案。"
          }
        }
      }
    },
